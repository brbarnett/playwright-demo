{
  "name": "playwright-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "workspaces": [
    "api",
    "web",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "test": "npm test -w api",
    "test:e2e": "npm test -w e2e --",
    "test:e2e:ui": "npm run test:ui -w e2e",
    "report": "npm run report -w e2e",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
